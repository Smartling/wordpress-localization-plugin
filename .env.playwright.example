# Copy to .env.playwright (gitignored) and fill in your values.
# Then run: source .env.playwright && npx playwright test

# Base URL of your local WordPress installation
PLAYWRIGHT_BASE_URL=http://localhost

# WordPress admin credentials
WP_ADMIN_USER=wp
WP_ADMIN_PASSWORD=wp

# ID of any published post on the main site to use for the post-edit page tests.
# In Docker CI this is set automatically by test.sh; locally pick any post ID.
E2E_TEST_POST_ID=1
